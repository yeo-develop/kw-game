.rules-host {
    width: 100%;
    height: 100%;
}
.rules-root {
    color: rgb(244, 241, 235);
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Pretendard-Regular.ttf");
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 32px 48px;
}
.rules-panel {
    width: 100%;
    max-width: 1420px;
    max-height: 100%;
    padding: 32px 40px;
    background-color: rgba(14, 18, 27, 0.98);
    border-width: 1px;
    border-color: rgb(81, 87, 105);
    border-radius: 22px;
}
.rules-heading { align-items: center; flex-shrink: 0; }
.rules-eyebrow { color: rgb(161, 168, 186); font-size: 18px; margin-bottom: 12px; letter-spacing: 2px; }
.rules-title { color: rgb(255, 211, 139); font-size: 48px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.rules-subtitle { font-size: 22px; color: rgb(186, 191, 205); margin-top: 10px; white-space: normal; -unity-text-align: middle-center; }
.rules-debt-strip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 24px;
    margin-bottom: 22px;
    padding: 15px 24px;
    background-color: rgb(34, 24, 34);
    border-width: 1px;
    border-color: rgb(100, 51, 68);
    border-radius: 12px;
}
.rules-debt-item { flex-direction: row; align-items: center; justify-content: center; }
.rules-debt-main { margin-right: 42px; padding-right: 42px; border-right-width: 1px; border-right-color: rgb(100, 51, 68); }
.rules-stat-label { font-size: 21px; margin-right: 20px; }
.rules-debt-value { font-size: 36px; color: rgb(255, 111, 148); -unity-font-style: bold; }
.rules-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 20px; }
.rules-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 14px 6px;
    background-color: rgb(24, 29, 41);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(52, 58, 74);
    border-radius: 0;
    color: rgb(169, 176, 195);
    font-size: 22px;
    -unity-text-align: middle-center;
}
.rules-tab:hover { background-color: rgb(37, 43, 57); color: rgb(255, 225, 177); }
.rules-tab-selected { color: rgb(255, 210, 132); border-bottom-color: rgb(255, 200, 107); background-color: rgb(39, 36, 36); -unity-font-style: bold; }
.rules-tab:focus { border-top-width: 1px; border-top-color: rgb(255, 210, 132); }
.rules-scroll { flex-shrink: 1; min-height: 0; overflow: hidden; }
.rules-scroll > .unity-scroll-view__content-viewport { min-height: 0; overflow: hidden; }
.rules-scroll .unity-scroll-view__content-container { flex-shrink: 0; }
.rules-page { padding-bottom: 2px; flex-shrink: 0; }
.rules-hidden { display: none; }
.rules-cards { flex-direction: row; flex-shrink: 0; }
.rules-card { flex-grow: 1; flex-basis: 0; background-color: rgb(24, 29, 40); border-width: 1px; border-color: rgb(54, 62, 80); border-radius: 12px; overflow: hidden; }
.rules-card-spaced { margin-right: 16px; }
.rules-card-art { height: 140px; -unity-background-scale-mode: scale-and-crop; justify-content: flex-start; padding: 12px; }
.rules-art-plan { background-image: url("project://database/Assets/Resources/Art/Backgrounds/room_night.jpg"); }
.rules-art-money { background-image: url("project://database/Assets/Resources/Art/Backgrounds/broker.jpg"); }
.rules-art-health { background-image: url("project://database/Assets/Resources/Art/Backgrounds/pc.jpg"); }
.rules-art-work { background-image: url("project://database/Assets/Resources/Art/Backgrounds/work.jpg"); }
.rules-art-casino { background-image: url("project://database/Assets/Resources/Art/Backgrounds/casino.jpg"); }
.rules-art-relic { background-image: url("project://database/Assets/Resources/Art/CG/opening_box.jpg"); }
.rules-art-rest { background-image: url("project://database/Assets/Resources/Art/Backgrounds/room_day.jpg"); }
.rules-art-park { background-image: url("project://database/Assets/Resources/Art/Backgrounds/park.jpg"); }
.rules-art-hospital { background-image: url("project://database/Assets/Resources/Art/Backgrounds/hosp.jpg"); }
.rules-card-number { align-self: flex-start; background-color: rgba(10, 14, 23, 0.88); color: rgb(255, 218, 154); font-size: 17px; padding: 5px 10px; border-radius: 5px; }
.rules-card-copy { padding: 20px 18px 24px; }
.rules-card-title { font-size: 26px; color: rgb(255, 212, 141); -unity-font-style: bold; white-space: normal; margin-bottom: 16px; }
.rules-card-value { font-size: 26px; -unity-font-style: bold; white-space: normal; margin-bottom: 10px; }
.rules-value-small { font-size: 22px; }
.rules-copy { font-size: 21px; color: rgb(181, 190, 210); white-space: normal; }
.rules-warning { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 18px; padding: 16px; background-color: rgb(48, 37, 25); border-width: 1px; border-color: rgb(154, 112, 54); border-radius: 10px; }
.rules-warning-title { color: rgb(255, 208, 126); -unity-font-style: bold; font-size: 23px; margin-right: 24px; }
.rules-warning-copy { font-size: 22px; white-space: normal; }
.rules-page-title { font-size: 28px; -unity-font-style: bold; color: rgb(255, 213, 144); margin-bottom: 16px; white-space: normal; }
.rules-topic-cards .rules-card-title { margin-bottom: 10px; }
.rules-topic-cards .rules-copy { margin-top: 8px; }
.rules-topic-risk { border-color: rgb(143, 76, 98); }
.rules-risk-copy { color: rgb(255, 151, 179); }
.rules-detail { font-size: 22px; white-space: normal; padding: 16px 20px; margin-bottom: 12px; background-color: rgb(24, 29, 40); border-radius: 8px; }
.rules-detail-intro { margin-bottom: 18px; }
.rules-footer { flex-direction: row; justify-content: flex-end; align-items: center; flex-shrink: 0; margin-top: 22px; padding-top: 20px; border-top-width: 1px; border-top-color: rgb(48, 55, 71); }
.rules-start { margin: 0; padding: 18px 28px; flex-shrink: 0; background-color: rgb(255, 202, 119); color: rgb(36, 25, 15); font-size: 24px; -unity-font-style: bold; border-width: 2px; border-color: rgb(255, 221, 164); border-radius: 10px; }
.rules-start:hover { background-color: rgb(255, 220, 161); }
.rules-start:active { background-color: rgb(231, 173, 86); }
.rules-start:focus { border-color: rgb(255, 249, 227); }
.rules-compact .rules-root { padding: 20px 32px; }
.rules-compact .rules-panel { padding: 22px 28px; }
.rules-compact .rules-title { font-size: 38px; }
.rules-compact .rules-eyebrow { margin-bottom: 6px; }
.rules-compact .rules-subtitle { font-size: 20px; margin-top: 6px; }
.rules-compact .rules-debt-strip { margin-top: 16px; margin-bottom: 14px; padding-top: 10px; padding-bottom: 10px; }
.rules-compact .rules-debt-value { font-size: 30px; }
.rules-compact .rules-tabs { margin-bottom: 14px; }
.rules-compact .rules-tab { padding-top: 10px; padding-bottom: 10px; font-size: 20px; }
.rules-compact .rules-card-art { height: 100px; }
.rules-compact .rules-card-copy { padding: 16px; }
.rules-compact .rules-card-title { font-size: 23px; margin-bottom: 10px; }
.rules-compact .rules-copy { font-size: 19px; }
.rules-compact .rules-warning { margin-top: 14px; padding: 12px; }
.rules-compact .rules-footer { margin-top: 16px; padding-top: 14px; }
.rules-narrow .rules-root { padding: 16px; }
.rules-narrow .rules-panel { padding: 20px; }
.rules-narrow .rules-title { font-size: 30px; }
.rules-narrow .rules-debt-strip { flex-direction: column; }
.rules-narrow .rules-debt-main { margin-right: 0; padding-right: 0; border-right-width: 0; margin-bottom: 8px; }
.rules-narrow .rules-cards { flex-direction: column; }
.rules-narrow .rules-card { flex-basis: auto; flex-shrink: 0; }
.rules-narrow .rules-card-spaced { margin-right: 0; margin-bottom: 12px; }
.rules-narrow .rules-card-art { height: 90px; }
.rules-narrow .rules-warning { flex-direction: column; }
.rules-narrow .rules-warning-title { margin-right: 0; margin-bottom: 8px; }
.rules-narrow .rules-tab { font-size: 17px; }
.rules-narrow .rules-footer { flex-direction: column; align-items: stretch; }
